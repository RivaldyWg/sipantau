# Salin berkas ini menjadi .env.local, lalu isi nilainya dari
# Project Settings -> API pada dashboard Supabase. Jangan pernah
# mengunggah .env.local ke git — sudah dikecualikan lewat .gitignore.

# Dipakai kode sisi peramban (lib/supabase/client) dan seed lokal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA dipakai kode sisi server (lib/supabase/server, Fungsi Tepi,
# skrip supabase/seed/002_akun_contoh.mjs). Kunci ini melewati seluruh
# aturan akses baris — JANGAN PERNAH dikirim ke sisi klien atau
# dipakai pada kode yang berjalan di peramban.
SUPABASE_SERVICE_ROLE_KEY=
